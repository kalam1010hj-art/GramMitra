# Local development
DEBUG=true
GRAMMITRA_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
# For production set GRAMMITRA_ENV=production, DEBUG=false and supply these:
SECRET_KEY=
DATABASE_URL=
CORS_ALLOWED_ORIGINS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Match the actual trusted reverse proxy chain.
TRUSTED_PROXY_COUNT=1
HSTS_PRELOAD=false
